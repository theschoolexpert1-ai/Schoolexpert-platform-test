{
 "slug": "course-provider",
 "title": "K–12 Individual Course Providers — Registration Form",
 "category": "learning",
 "label": "K-12 Course Providers",
 "entity": "organisation",
 "intro": [
  "Designed for providers offering individual courses to K–12 students, parents, teachers or schools in India. The structure allows one provider account to register multiple courses, with each course receiving a separate Course ID and public listing."
 ],
 "outro": [],
