{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": { "api/index.py": { "maxDuration": 60, "includeFiles": "tse/**" } },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "crons": [
    { "path": "/cron/outbox", "schedule": "0 3 * * *" },
    { "path": "/cron/housekeeping", "schedule": "30 21 * * *" }
  ]
}
