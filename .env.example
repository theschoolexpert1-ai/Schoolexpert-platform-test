# ---- copy to .env and fill in (never commit .env) ----
TSE_ENV=production
SITE_URL=https://www.schoolexpert.in
SECRET_KEY=change-me-64-random-chars          # python3 -c "import secrets;print(secrets.token_urlsafe(48))"
# Encryption key ring for private data (newest first). Generate: python3 -c "import os,base64;print('v1:'+base64.b64encode(os.urandom(32)).decode())"
# Keep an offline copy in a password manager / sealed envelope — without it encrypted documents cannot be recovered.
FIELD_ENCRYPTION_KEYS=v1:
# App connects as the least-privilege role (no DDL); migrations/backups use the owner role.
DATABASE_URL=postgresql://tse_app:STRONG_PASSWORD@127.0.0.1:5432/schoolexpert
MIGRATION_DATABASE_URL=postgresql://tse:OWNER_PASSWORD@127.0.0.1:5432/schoolexpert
# Remote/managed database: append ?sslmode=require
# ---- security ----
TSE_ENV=production
SESSION_COOKIE_SECURE=true
MFA_REQUIRED_FOR_STAFF=true
IDLE_MINUTES_STAFF=30
IDLE_HOURS_USER=72
ADMIN_IP_ALLOWLIST=                            # e.g. 203.0.113.10,198.51.100.0/24  (office / VPN)
TRUSTED_PROXIES=1                              # nginx in front of the app
CLAMD_HOST=127.0.0.1                           # virus-scan uploads (installed by deploy/harden-server.sh)
EMBED_FRAME_ANCESTORS=https://www.schoolexpert.in https://schoolexpert.in https:
DB_POOL_SIZE=10
SESSION_COOKIE_SECURE=1

# Uploads: local now, S3-compatible after cloud migration
STORAGE_BACKEND=local
UPLOAD_DIR=/var/www/schoolexpert/var/uploads
PRIVATE_UPLOAD_DIR=/var/www/schoolexpert/var/private
# S3_BUCKET=  S3_REGION=ap-south-1  S3_ENDPOINT=  S3_ACCESS_KEY=  S3_SECRET_KEY=

# Payments (Razorpay). Keep PAYMENT_GATEWAY=mock until keys are live.
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=rzp_live_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx
TSE_GSTIN=

# CRM: none | webhook | zoho | hubspot | leadsquared
CRM_PROVIDER=none
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_DC=in
HUBSPOT_TOKEN=
LEADSQUARED_HOST=
LEADSQUARED_ACCESS_KEY=
LEADSQUARED_SECRET_KEY=

# Email (GoDaddy Professional Email / Microsoft 365 / Google Workspace / Amazon SES)
MAIL_FROM=The School Expert <info@schoolexpert.in>
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=587
SMTP_USER=info@schoolexpert.in
SMTP_PASSWORD=
SMTP_TLS=1

# SMS OTP (guardian consent): console | msg91
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
DEV_SHOW_OTP=0

# AI CV builder (optional — template fallback without it)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Analytics / SEM — loaded only after cookie consent
GA4_ID=
GOOGLE_ADS_ID=
GOOGLE_SITE_VERIFICATION=

GRIEVANCE_OFFICER=Grievance Officer, The School Expert™
GRIEVANCE_EMAIL=info@schoolexpert.in
